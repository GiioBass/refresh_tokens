# Grownet API V2 Base Configuration
VITE_API_BASE_URL=https://prueba.com/api/v2
VITE_API_LOGIN_PATH=/auth/login/login
VITE_API_PIN_LOGIN_PATH=/auth/login/pin
VITE_API_REFRESH_PATH=/auth/login/refresh
VITE_API_TENANT=premaster
VITE_API_TIMEZONE=America/Bogota
VITE_APP_ID=1

# Default Mock Credentials (Masked)
VITE_DEFAULT_EMAIL=user@example.com
VITE_DEFAULT_PASSWORD=your_password_here
VITE_DEFAULT_PIN=your_pin_here
VITE_DEFAULT_CLIENT_TYPE=mobile

# Session Expiry & Rotation Tuning
VITE_TOKEN_EXPIRY_SECONDS=300
VITE_AUTO_PING_SECONDS=10
